{
  "name": "emc-pro",
  "private": true,
  "version": "2.0.0",
  "description": "Инструментарий инженера ЭМС — ГОСТ РВ 20.57.306",
  "author": "Кондратьев Г.Д.",
  "main": "electron.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:community": "VITE_APP_EDITION=community vite build",
    "build:personal": "VITE_APP_EDITION=personal vite build",
    "build:pro": "VITE_APP_EDITION=pro vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:build": "npm run build && electron-builder",
    "electron:build:personal": "npm run build:personal && electron-builder",
    "electron:build:pro": "npm run build:pro && electron-builder",
    "test:license": "node --test test/license.test.cjs",
    "test:engineering": "node --test test/engineering.test.mjs"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@capacitor/core": "5.7.8",
    "@capacitor/ios": "5.7.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "vite": "^5.0.8",
    "@capacitor/cli": "5.7.8"
  },
  "build": {
    "appId": "ru.emc.pro",
    "productName": "EMC Pro",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron.js",
      "preload.cjs",
      "license-public-key.cjs",
      "license-verifier.cjs",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "forceCodeSigning": false,
    "extraResources": [
      {
        "from": "ai-runtime",
        "to": "ai-runtime",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
